{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BANTWORKS MCP",
  "version": "1.8.0",
  "identifier": "com.bobworks.bantworksmcp",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm --prefix .. run release:server",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 700,
        "minHeight": 600,
        "minWidth": 560,
        "resizable": true,
        "title": "BANTWORKS MCP",
        "width": 900,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "BOBWORKS",
    "publisher": "BOBWORKS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../release/banter-mcp.mjs": "server/banter-mcp.mjs",
      "../../unity-extension/Editor/BanterMCPBridge.cs": "server/unity-extension/Editor/BanterMCPBridge.cs",
      "../../LICENSE": "server/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "server/THIRD_PARTY_NOTICES.md"
    },
    "longDescription": "Configure and manage BANTWORKS MCP for Codex, Claude Code, and Unity integration",
    "shortDescription": "BANTWORKS MCP Launcher",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
