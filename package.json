{
  "name": "banter-mcp",
  "version": "2.0.0",
  "description": "Codex, Claude Code, and MCP-compatible Unity integration for Banter SDK development",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle:server": "npm run build && esbuild dist/index.js --bundle --platform=node --format=esm --target=node18 --outfile=release/banter-mcp.mjs",
    "stage:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-node-runtime.ps1",
    "check:version": "node scripts/check-version-sync.mjs",
    "test:bundle": "node scripts/smoke-release-bundle.mjs",
    "release:server": "npm run bundle:server && npm run test:bundle",
    "release:launcher": "npm run release:server && npm run stage:runtime",
    "test": "npm run build && node --test test/*.test.mjs",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js"
  },
  "keywords": [
    "mcp",
    "banter",
    "unity",
    "visual-scripting",
    "vr"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
